# Configuración requerida
# Copia este archivo a .env y completa los valores

# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/inventario

# Autenticación
JWT_SECRET=change_this_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# Backend
BACKEND_PORT=4000

# Node environment
NODE_ENV=development
